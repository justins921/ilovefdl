generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ───────────────────────────────────────────────

enum Role {
  ADMIN
  VENDOR
  EDITOR
  USER
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  FULFILLED
  REFUNDED
  CANCELLED
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum PostCategory {
  THE_FONDY_FRONTLINE
  FACES_OF_OUR_FUTURE
  FINDING_BALANCE
  PLAY_EXPLORE_REPEAT
  HOMEGROWN_HEROS
  THE_CREATIVE_CORNER
  WEEKLY_SAVINGS
  UNCATEGORIZED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ExternalPlatform {
  NATIVE
  SHOPIFY
  SQUARE
  ETSY
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ShippingType {
  FLAT_RATE
  FREE
  WEIGHT_BASED
  PRICE_BASED
  LOCAL_PICKUP
}

enum MessageRole {
  CUSTOMER
  VENDOR
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
}

// ─── USER ────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  role         Role     @default(USER)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendor                 Vendor?
  orders                 Order[]
  blogPosts              BlogPost[]
  pushTokens             PushToken[]
  notificationPreference NotificationPreference?
  passwordResetTokens    PasswordResetToken[]
  reviews                Review[]
  wishlistItems          WishlistItem[]
  savedAddresses         SavedAddress[]
  sentMessages           Message[]           @relation("SenderMessages")
  receivedMessages       Message[]           @relation("RecipientMessages")
  conversations          ConversationParticipant[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@map("password_reset_tokens")
}

// ─── SAVED ADDRESSES ────────────────────────────────────

model SavedAddress {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String  @default("Home")
  name       String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String  @default("US")
  phone      String?
  isDefault  Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@map("saved_addresses")
}

// ─── VENDOR ──────────────────────────────────────────────

model Vendor {
  id                String       @id @default(cuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName      String
  slug              String       @unique
  description       String?
  logoUrl           String?
  bannerUrl         String?
  address           String?
  phone             String?
  website           String?
  socialLinks       Json?
  status            VendorStatus @default(PENDING)
  stripeAccountId   String?
  stripeOnboarded   Boolean      @default(false)
  commissionRate    Float        @default(0.05)
  vacationMode      Boolean      @default(false)
  vacationMessage   String?
  seoTitle          String?
  seoDescription    String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  products          Product[]
  orders            Order[]
  vendorConnections VendorConnection[]
  coupons           Coupon[]
  shippingProfiles  ShippingProfile[]
  reviews           Review[]

  @@map("vendors")
}

// Phase 2: External platform connections for catalog sync
model VendorConnection {
  id               String           @id @default(cuid())
  vendorId         String
  vendor           Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  platform         ExternalPlatform
  accessToken      String?
  refreshToken     String?
  shopDomain       String?
  externalShopId   String?
  lastSyncAt       DateTime?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([vendorId, platform])
  @@map("vendor_connections")
}

// ─── SHIPPING PROFILES ──────────────────────────────────

model ShippingProfile {
  id              String       @id @default(cuid())
  vendorId        String
  vendor          Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name            String
  shippingType    ShippingType @default(FLAT_RATE)
  price           Float        @default(0)
  freeAbove       Float?
  estimatedDays   String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([vendorId])
  @@map("shipping_profiles")
}

// ─── PRODUCT ─────────────────────────────────────────────

model Product {
  id               String           @id @default(cuid())
  vendorId         String
  vendor           Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name             String
  slug             String           @unique
  description      String?
  price            Float
  compareAtPrice   Float?
  sku              String?
  weight           Float?
  weightUnit       String?          @default("oz")
  images           String[]
  categoryTags     String[]
  inventory        Int              @default(0)
  lowStockThreshold Int             @default(5)
  isActive         Boolean          @default(true)
  isFeatured       Boolean          @default(false)
  externalPlatform ExternalPlatform @default(NATIVE)
  externalId       String?
  seoTitle         String?
  seoDescription   String?
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  orderItems    OrderItem[]
  variants      ProductVariant[]
  attributes    ProductAttribute[]
  reviews       Review[]
  wishlistItems WishlistItem[]

  @@index([vendorId])
  @@index([externalPlatform, externalId])
  @@map("products")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  sku       String?
  price     Float
  compareAtPrice Float?
  inventory Int     @default(0)
  images    String[]
  options   Json
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

model ProductAttribute {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  values    String[]
  createdAt DateTime @default(now())

  @@unique([productId, name])
  @@map("product_attributes")
}

// ─── REVIEWS ─────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  rating    Int
  title     String?
  body      String?
  images    String[]
  isVerifiedPurchase Boolean @default(false)
  isApproved Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId])
  @@index([vendorId])
  @@map("reviews")
}

// ─── WISHLIST ────────────────────────────────────────────

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

// ─── COUPONS ─────────────────────────────────────────────

model Coupon {
  id             String     @id @default(cuid())
  vendorId       String?
  vendor         Vendor?    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  code           String     @unique
  type           CouponType
  value          Float
  minOrderAmount Float?
  maxUses        Int?
  usedCount      Int        @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  redemptions CouponRedemption[]

  @@index([code])
  @@index([vendorId])
  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId   String
  userId    String
  discount  Float
  createdAt DateTime @default(now())

  @@unique([couponId, orderId])
  @@map("coupon_redemptions")
}

// ─── ORDER ───────────────────────────────────────────────

model Order {
  id                   String      @id @default(cuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id])
  vendorId             String
  vendor               Vendor      @relation(fields: [vendorId], references: [id])
  status               OrderStatus @default(PENDING)

  subtotal             Float
  tax                  Float       @default(0)
  shipping             Float       @default(0)
  discount             Float       @default(0)
  total                Float

  commissionBaseAmount Float
  commissionRate       Float       @default(0.05)
  commissionAmount     Float
  vendorNetAmount      Float
  processorFeeAmount   Float       @default(0)

  orderGroupId         String?
  stripeSessionId      String?     @unique
  stripePaymentIntent  String?     @unique
  couponCode           String?
  trackingNumber       String?
  trackingCarrier      String?
  shippedAt            DateTime?
  fulfilledAt          DateTime?

  shippingAddress      Json?
  notes                String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  items   OrderItem[]
  refunds Refund[]

  @@index([userId])
  @@index([vendorId])
  @@index([orderGroupId])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  variantName String?
  quantity    Int
  unitPrice   Float
  total       Float

  @@map("order_items")
}

// ─── REFUNDS ─────────────────────────────────────────────

model Refund {
  id               String       @id @default(cuid())
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount           Float
  reason           String?
  status           RefundStatus @default(REQUESTED)
  stripeRefundId   String?
  processedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([orderId])
  @@map("refunds")
}

// ─── MESSAGING ───────────────────────────────────────────

model Conversation {
  id           String   @id @default(cuid())
  subject      String?
  orderId      String?
  productId    String?
  lastMessageAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SenderMessages", fields: [senderId], references: [id])
  recipientId    String?
  recipient      User?        @relation("RecipientMessages", fields: [recipientId], references: [id])
  body           String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

// ─── BLOG ────────────────────────────────────────────────

model BlogPost {
  id            String       @id @default(cuid())
  authorId      String
  author        User         @relation(fields: [authorId], references: [id])
  title         String
  slug          String       @unique
  content       String
  excerpt       String?
  featuredImage String?
  category      PostCategory @default(UNCATEGORIZED)
  tags          String[]
  status        PostStatus   @default(DRAFT)
  publishedAt   DateTime?
  scheduledAt   DateTime?
  seoTitle      String?
  seoDescription String?
  wpOriginalId  Int?         @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([category])
  @@index([status])
  @@map("blog_posts")
}

// ─── BAR DIRECTORY ───────────────────────────────────────

model Bar {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  address     String
  mapLink     String?
  phone       String?
  website     String?
  hours       Json?
  photos      String[]
  socialLinks Json?
  ownerId     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  specials Special[]

  @@map("bars")
}

model Special {
  id          String    @id @default(cuid())
  barId       String
  bar         Bar       @relation(fields: [barId], references: [id], onDelete: Cascade)
  dayOfWeek   DayOfWeek
  title       String
  description String?
  price       String?
  startTime   String?
  endTime     String?
  isFeatured  Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([barId, dayOfWeek])
  @@map("specials")
}

// ─── PUSH NOTIFICATIONS ─────────────────────────────────

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  @@map("push_tokens")
}

model NotificationPreference {
  id             String  @id @default(cuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  breakingNews   Boolean @default(true)
  dailySpecials  Boolean @default(true)
  orderUpdates   Boolean @default(true)
  categoryAlerts Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("notification_preferences")
}
