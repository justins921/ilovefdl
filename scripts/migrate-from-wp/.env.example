# Database connection string for the I Love FDL platform
# Replace with your actual PostgreSQL connection URL
DATABASE_URL="postgresql://user:password@localhost:5432/ilovefdl?schema=public"

# API server URL (where images will be uploaded)
API_BASE_URL="http://localhost:4000"

# Migration API key (must match MIGRATION_API_KEY on the API server)
MIGRATION_API_KEY="your-secret-migration-key"
